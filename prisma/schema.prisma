// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH MODELS (NextAuth / Auth.js v5)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(COMPANY)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  systemLogs    SystemLog[]

  companyProfile CompanyProfile?
  umkmProfile    UmkmProfile?

  @@index([email])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@map("password_reset_tokens")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  COMPANY
  UMKM
  ADMIN
}

enum RFQStatus {
  DRAFT
  OPEN
  IN_REVIEW
  AWARDED
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEGOTIATING
  WITHDRAWN
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CertificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum UmkmVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products      Product[]
  rfqs          RFQ[]
  supplyGapData SupplyGapData[]
  umkmProfiles  UmkmProfile[]   @relation("UmkmCategories")

  @@index([slug])
  @@map("categories")
}

// ============================================================
// COMPANY PROFILE
// ============================================================

model CompanyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  industry    String?
  province    String?
  city        String?
  address     String?
  phone       String?
  website     String?
  description String?
  logo        String?
  npwp        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfqs  RFQ[]

  @@map("company_profiles")
}

// ============================================================
// UMKM PROFILE
// ============================================================

model UmkmProfile {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  businessName       String
  tagline            String?
  description        String?
  province           String?
  city               String?
  address            String?
  phone              String?
  email              String?
  website            String?
  logo               String?
  coverImage         String?
  foundedYear        Int?
  employeeCount      Int?
  npwp               String?
  nib                String?
  siup               String?
  latitude           Float?
  longitude          Float?
  verificationStatus UmkmVerificationStatus @default(PENDING)
  readinessScore     Int                    @default(0)
  profileCompleteness Int                  @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories     Category[]      @relation("UmkmCategories")
  products       Product[]
  certifications Certification[]
  machines       Machine[]
  factoryPhotos  FactoryPhoto[]
  reviews        Review[]
  projects       Project[]
  quotations     Quotation[]
  trustScore     TrustScore?
  aiRecommendations AIRecommendation[]
  portfolio      Portfolio[]
  directRfqs     RFQ[]            @relation("DirectRFQs")

  @@index([province, city])
  @@index([readinessScore])
  @@map("umkm_profiles")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String   @id @default(cuid())
  umkmId      String
  categoryId  String?
  name        String
  description String?
  unit        String?
  minOrder    Int?
  maxCapacity Int?
  leadTimeDays Int?
  priceMin    Float?
  priceMax    Float?
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id])

  @@index([umkmId])
  @@index([categoryId])
  @@map("products")
}

// ============================================================
// CERTIFICATIONS
// ============================================================

model Certification {
  id          String              @id @default(cuid())
  umkmId      String
  name        String
  issuer      String?
  number      String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  documentUrl String?
  status      CertificationStatus @default(PENDING)
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
  @@map("certifications")
}

// ============================================================
// MACHINES
// ============================================================

model Machine {
  id          String   @id @default(cuid())
  umkmId      String
  name        String
  brand       String?
  model       String?
  quantity    Int?
  yearAcquired Int?
  capacity    String?
  condition   String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("machines")
}

// ============================================================
// FACTORY PHOTOS
// ============================================================

model FactoryPhoto {
  id          String   @id @default(cuid())
  umkmId      String
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("factory_photos")
}

// ============================================================
// PORTFOLIO
// ============================================================

model Portfolio {
  id          String   @id @default(cuid())
  umkmId      String
  title       String
  description String?
  clientName  String?
  value       Float?
  completedAt DateTime?
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("portfolio")
}

// ============================================================
// RFQ (REQUEST FOR QUOTATION)
// ============================================================

model RFQ {
  id             String    @id @default(cuid())
  companyId      String
  targetUmkmId   String?
  title          String
  description    String
  categoryId     String?
  quantity       Int?
  unit           String?
  budgetMin      Float?
  budgetMax      Float?
  deadline       DateTime?
  specifications String?
  attachments    String[]
  status         RFQStatus @default(DRAFT)
  isAIGenerated  Boolean   @default(false)
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  companyProfile    CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetUmkm        UmkmProfile?      @relation("DirectRFQs", fields: [targetUmkmId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id])
  quotations        Quotation[]
  aiRecommendations AIRecommendation[]
  project           Project?

  @@index([companyId])
  @@index([targetUmkmId])
  @@index([status])
  @@index([categoryId])
  @@map("rfqs")
}

// ============================================================
// QUOTATIONS
// ============================================================

model Quotation {
  id                 String          @id @default(cuid())
  rfqId              String
  umkmId             String
  price              Float
  leadTimeDays       Int?
  notes              String?
  attachments        String[]
  status             QuotationStatus @default(PENDING)
  negotiationHistory Json?
  validUntil         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  rfq         RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@unique([rfqId, umkmId])
  @@index([rfqId])
  @@index([umkmId])
  @@map("quotations")
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id         String        @id @default(cuid())
  rfqId      String        @unique
  umkmId     String
  companyId  String
  status     ProjectStatus @default(ACTIVE)
  value      Float?
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  rfq         RFQ         @relation(fields: [rfqId], references: [id])
  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id])
  reviews     Review[]

  @@index([umkmId])
  @@index([companyId])
  @@map("projects")
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id        String   @id @default(cuid())
  umkmId    String
  companyId String
  projectId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id])

  @@index([umkmId])
  @@map("reviews")
}

// ============================================================
// TRUST SCORE
// ============================================================

model TrustScore {
  id               String   @id @default(cuid())
  umkmId           String   @unique
  overall          Int      @default(0)
  deliveryScore    Int      @default(0)
  responsivenessScore Int   @default(0)
  qualityScore     Int      @default(0)
  certificationScore Int    @default(0)
  portfolioScore   Int      @default(0)
  completedProjects Int     @default(0)
  strengths        String[]
  weaknesses       String[]
  suggestions      String[]
  calculatedAt     DateTime @default(now())

  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("trust_scores")
}

// ============================================================
// AI RECOMMENDATIONS
// ============================================================

model AIRecommendation {
  id          String   @id @default(cuid())
  rfqId       String
  umkmId      String
  matchScore  Int
  explanation String?
  reasons     String[]
  rank        Int      @default(0)
  createdAt   DateTime @default(now())

  rfq         RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  umkmProfile UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@unique([rfqId, umkmId])
  @@index([rfqId])
  @@map("ai_recommendations")
}

// ============================================================
// SAVED SUPPLIERS
// ============================================================

model SavedSupplier {
  id        String   @id @default(cuid())
  userId    String
  umkmId    String
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, umkmId])
  @@index([userId])
  @@map("saved_suppliers")
}

// ============================================================
// SUPPLY GAP DATA
// ============================================================

model SupplyGapData {
  id              String   @id @default(cuid())
  province        String
  city            String?
  categoryId      String?
  demandScore     Int      @default(0)
  supplierCount   Int      @default(0)
  opportunityScore Int     @default(0)
  updatedAt       DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([province])
  @@map("supply_gap_data")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ============================================================
// SYSTEM LOGS
// ============================================================

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}

// ============================================================
// ORDERS (MARKETPLACE)
// ============================================================

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

model Order {
  id           String      @id @default(cuid())
  quotationId  String      @unique
  rfqId        String
  companyId    String
  umkmId       String
  status       OrderStatus @default(PENDING_PAYMENT)
  totalAmount  Float
  notes        String?
  paidAt       DateTime?
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  trackingInfo String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([umkmId])
  @@index([rfqId])
  @@map("orders")
}

// ============================================================
// CHAT / MESSAGES
// ============================================================

model Conversation {
  id             String    @id @default(cuid())
  companyUserId  String
  umkmUserId     String
  rfqId          String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([companyUserId, umkmUserId])
  @@index([companyUserId])
  @@index([umkmUserId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
